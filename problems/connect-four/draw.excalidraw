      "isDeleted": false,
      "boundElements": null,
      "updated": 1788115537976,
      "link": null,
      "locked": false,
      "text": "Common mistakes\n\nbool states for evrything ex: isOver, hasWinner, isDraw\nproblem: all are coupled boolean flag that must stay synchronised\n        three states but 8 combinations of booleans\n        sol: Keep an enum with three states: Inprogress, won, draw\n        \n        if we have to add new states like abandoned or paused, we can just expand the enum\n        no need to create a new bool",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Common mistakes\n\nbool states for evrything ex: isOver, hasWinner, isDraw\nproblem: all are coupled boolean flag that must stay synchronised\n        three states but 8 combinations of booleans\n        sol: Keep an enum with three states: Inprogress, won, draw\n        \n        if we have to add new states like abandoned or paused, we can just expand the enum\n        no need to create a new bool",
      "autoResize": true,
      "lineHeight": 1.25
    },
